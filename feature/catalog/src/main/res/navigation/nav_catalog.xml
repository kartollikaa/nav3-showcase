<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/dest_catalog"
    app:startDestination="@id/catalogListFragment">

    <!-- Entry point of the feature. Other modules navigate here by the shared @id/dest_catalog
         (this graph's id, declared in :core:designsystem) — by resource id, not a deep-link URI. -->
    <fragment
        android:id="@+id/catalogListFragment"
        android:name="io.dodo.nav3.feature.catalog.CatalogListFragment"
        android:label="Catalog">
        <action
            android:id="@+id/action_catalogList_to_product"
            app:destination="@id/productFragment" />
    </fragment>

    <fragment
        android:id="@+id/productFragment"
        android:name="io.dodo.nav3.feature.catalog.ProductFragment"
        android:label="Product">
        <argument
            android:name="id"
            app:argType="string" />
    </fragment>

    <!-- The filter — a Material BottomSheetDialogFragment as a <dialog> destination, reached from the
         list by this module's own @id/filterBottomSheetFragment. -->
    <dialog
        android:id="@+id/filterBottomSheetFragment"
        android:name="io.dodo.nav3.feature.catalog.FilterBottomSheetFragment"
        android:label="Filter" />
</navigation>

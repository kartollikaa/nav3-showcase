<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/dest_catalog"
    app:startDestination="@id/catalogFragment">

    <!-- One Nav2 destination now. Everything INSIDE the catalog (list -> product, the filter sheet)
         moved into a Nav3 NavDisplay hosted by this fragment. Other modules still reach the catalog by
         the shared @id/dest_catalog (this graph's id, declared in :core:designsystem). -->
    <fragment
        android:id="@+id/catalogFragment"
        android:name="io.dodo.nav3.feature.catalog.CatalogFragment"
        android:label="Catalog" />
</navigation>

<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="io.dodo.nav3.feature.home.HomeFragment"
        android:label="Home" />

    <!-- The auth feature owns its OWN nested graph (per-feature nested navigation). -->
    <include app:graph="@navigation/nav_auth" />

    <!-- A bottom sheet, the Navigation 2 way: a BottomSheetDialogFragment as a <dialog> destination.
         Its id is the shared @id/dest_promo (declared in :core:designsystem) so feature:home can
         navigate to it by resource id. -->
    <dialog
        android:id="@id/dest_promo"
        android:name="io.dodo.nav3.feature.home.PromoBottomSheetFragment"
        android:label="Promo" />

    <!-- A dialog destination (DialogFragment), reached by the shared @id/dest_confirm. -->
    <dialog
        android:id="@id/dest_confirm"
        android:name="io.dodo.nav3.feature.home.ConfirmDialogFragment"
        android:label="Confirm" />
</navigation>

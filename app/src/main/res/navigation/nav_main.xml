<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="io.dodo.nav3.feature.home.HomeFragment"
        android:label="Home" />

    <!-- Each feature owns its OWN nested graph (per-feature nested navigation). The catalog's
         filter bottom sheet lives INSIDE the catalog graph — it belongs to the feature. -->
    <include app:graph="@navigation/nav_auth" />
    <include app:graph="@navigation/nav_catalog" />

    <!-- A dialog destination (DialogFragment), reached by the shared @id/dest_confirm. It stays in
         root (:app) — the one overlay that remains here until the very end of the migration. -->
    <dialog
        android:id="@id/dest_confirm"
        android:name="io.dodo.nav3.feature.home.ConfirmDialogFragment"
        android:label="Confirm" />
</navigation>
